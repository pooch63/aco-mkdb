        - using Random
        - 
        - function random_graph(; nU_range=3:6, nV_range=3:6, edge_prob=0.5,
        -     θ_max::Union{Int,Nothing}=nothing, k_max::Int=4)
        0     isempty(nU_range) && throw(ArgumentError("nU_range is empty: $nU_range (need lo ≤ hi)"))
        0     isempty(nV_range) && throw(ArgumentError("nV_range is empty: $nV_range (need lo ≤ hi)"))
        0     nU = rand(nU_range)
        0     nV = rand(nV_range)
        - 
        -     # θ must be small enough that a valid biclique can exist at all.
        0     θ_hi = min(nU, nV)
        -     if θ_max !== nothing
        0         θ_hi = min(θ_hi, θ_max)
        -     end
        0     θ = rand(1:θ_hi)
        -     # k must be small enough to keep search meaningful (not "anything goes").
        0     k = rand(0:min(nU * nV, k_max, θ - 1))
        - 
        -     # Plant a θ×θ k-defective biclique so a feasible solution always exists.
        0     plant_U = randperm(nU)[1:θ]
        0     plant_V = randperm(nV)[1:θ]
        0     plant_pairs = [(u, v) for u in plant_U for v in plant_V]
        0     shuffle!(plant_pairs)
        -     # First k pairs are intentionally missing; the rest are present.
        0     edges = Set{Tuple{Int,Int}}(plant_pairs[k+1:end])
        0     plant_set = Set(plant_pairs)
        - 
        0     for u in 1:nU, v in 1:nV
        0         (u, v) in plant_set && continue
        0         if rand() < edge_prob
        0             push!(edges, (u, v))
        -         end
        0     end
        - 
        0     return edges, nU, nV, k, θ
        - end
