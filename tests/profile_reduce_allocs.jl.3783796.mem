        - # Allocation profile for reduce_graph! only.
        - #
        - # Usage:
        - #   # Step A — overview (%gc, alloc count):
        - #   julia tests/profile_reduce_allocs.jl
        - #
        - #   # Step B — line-level .mem files (run AFTER step A once, or alone):
        - #   julia --track-allocation=user tests/profile_reduce_allocs.jl
        - #   # then inspect src/reduction.jl.mem (and graph.jl.mem)
        - #
        - # Same CLI flags as suite / test_reduction_modes --time:
        - #   --seed=  --nU=  --nV=  --edge-prob=  --theta-max=  --k-max=
        - 
        - include(joinpath(@__DIR__, "suite.jl"))
        - isdefined(@__MODULE__, :__REDUCTION_JL__) || include(joinpath(SRC, "reduction.jl"))
        - 
        - using Profile
        - 
        - function main()
        0     defaults = suite_cli_defaults()
        -     # Prefer a single reproducible graph: --seed=X with N-style fixed seed.
        0     seed = defaults.seed
        0     nU_range = defaults.nU_range
        0     nV_range = defaults.nV_range
        0     edge_prob = defaults.edge_prob
        0     θ_max = defaults.θ_max
        0     k_max = defaults.k_max
        - 
        0     edges, nU, nV, k, θ = random_graph_from_seed(seed;
        -         nU_range=nU_range, nV_range=nV_range, edge_prob=edge_prob,
        -         θ_max=θ_max, k_max=k_max)
        0     fg = build_frozen(edges, nU, nV)
        - 
        0     println("Allocation profile: reduce_graph!")
        0     println("  seed=$seed  nU=$nU  nV=$nV  |E|=$(length(edges))  k=$k  θ=$θ")
        0     println("  nU_range=$nU_range  nV_range=$nV_range  edge_prob=$edge_prob")
        0     println()
        - 
        -     # Warmup — exclude compilation from both @time and .mem
        0     g_warm = build_mutable_graph(fg)
        0     reduce_graph!(g_warm, k, θ, nU, nV)
        - 
        -     # Clear allocation counters so .mem only covers the measured call
        0     Profile.clear_malloc_data()
        - 
        0     g = build_mutable_graph(fg)
        0     println("Measured call (@time):")
       80     @time reduce_graph!(g, k, θ, nU, nV)
        0     println()
        0     println("If run with --track-allocation=user, open:")
        0     println("  src/reduction.jl.mem")
        0     println("  src/graph.jl.mem")
        0     println("Right-hand column = bytes allocated on that line.")
        - end
        - 
        - main()
