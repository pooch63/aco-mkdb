{
  "source": "main.tex",
  "output": "build.tex",
  "generated_dir": "generated",
  "pdf": "build.pdf",
  "vary_base": "../results/vary_",
  "fragments": {
    "QUALITY": {
      "emit": "quality",
      "input": "../results/vary_k2t5i_2_200_PN",
      "file": "quality.tex"
    },
    "SEED_COMPARE": {
      "emit": "seed-compare",
      "input": "../results/compare_k2t5i_konect-small",
      "vary_dir": "../results/vary_k2t5i_PN",
      "file": "seed-compare.tex"
    },
    "TABLE": {
      "emit": "table",
      "ants": 100,
      "file": "table.tex"
    },
    "COMPARE": {
      "emit": "compare",
      "input": "../results/vary_k2t5i_PN",
      "ants": 100,
      "flag_dirs": {
        "ACO": "../results/vary_k2t5i_100_",
        "ACO-P": "../results/vary_k2t5i_P",
        "ACO-N": "../results/vary_k2t5i_100_N",
        "ACO-PN": "../results/vary_k2t5i_PN"
      }
    },
    "STATISTICS": {
      "emit": "statistics",
      "input": "../results/vary_k2t5i_PN",
      "ants": 100,
      "missing_at_base": "../results/vary_k2t5i_100_"
    }
  }
}
