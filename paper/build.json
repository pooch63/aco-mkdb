{
  "source": "main.tex",
  "output": "build.tex",
  "generated_dir": "generated",
  "pdf": "build.pdf",
  "tables_source": "tables.tex",
  "tables_output": "tables-build.tex",
  "tables_pdf": "tables.pdf",
  "results_dir": "../results",
  "vary_base": "vary_",
  "max_replicates": 1,
  "fragments": {
    "QUALITY": {
      "emit": "quality",
      "input": "vary_k2t5i_2_200_PN",
      "file": "quality.tex",
      "ablation_dirs": {
        "rho": "ablate_rho_k2t5i_PN",
        "pheromone": "ablate_pheromone_k2t5i_PN",
        "eta-exp": "ablate_eta-exp_k2t5i_PN"
      },
      "budget_dir": "budget_k2t5i_PN"
    },
    "SEED_COMPARE": {
      "emit": "seed-compare",
      "input": "compare_k2t5i",
      "vary_dir": "vary_k2t5i_PN",
      "file": "seed-compare.tex"
    },
    "TABLE": {
      "emit": "table",
      "ants": 100,
      "file": "table.tex"
    },
    "COMPARE": {
      "emit": "compare",
      "input": "vary_k2t5i_PN",
      "ants": 100,
      "flag_dirs": {
        "ACO": "vary_k2t5i_100_",
        "$F_P$": "vary_k2t5i_P",
        "$F_N$": "vary_k2t5i_100_N",
        "$F_{PN}$": "vary_k2t5i_PN"
      },
      "budget_dir": "budget_k2t5i_PN",
      "ablation_dirs": {
        "dt0": "budget_k2t5i_PN_dt0",
        "rho0.01": "budget_k2t5i_PN_rho001",
        "rho0.2": "budget_k2t5i_PN_rho020",
        "rho0.5": "budget_k2t5i_PN_rho050"
      },
      "param_dirs": {
        "k1t5": "vary_k1t5i_PN",
        "k2t5": "vary_k2t5i_PN",
        "k3t5": "vary_k3t5i_PN",
        "k4t5": "vary_k4t5i_PN",

        "k1t8": "vary_k1t8i_PN",
        "k2t8": "vary_k2t8i_PN",
        "k3t8": "vary_k3t8i_PN",
        "k4t8": "vary_k4t8i_PN",
        "k5t8": "vary_k5t8i_PN",
        "k6t8": "vary_k6t8i_PN",

        "k3t6": "vary_k3t6i_PN",
        "k3t7": "vary_k3t7i_PN"
      },
      "runtime_sweeps": {
        "k": [
          {"theta": 5, "values": [1, 2, 3, 4]},
          {"theta": 8, "values": [1, 2, 3, 4, 5, 6]}
        ],
        "theta": [
          {"k": 3, "values": [5, 6, 7, 8]}
        ]
      }
    },
    "METHODS": {
      "emit": "methods",
      "methods": ["tow", "aco", "heuristic"]
    },
    "STATISTICS": {
      "emit": "statistics",
      "input": "vary_k2t5i_PN",
      "ants": 100,
      "missing_at_base": "vary_k2t5i_100_",
      "compare_dir": "compare_k2t5i"
    },
    "ABLATION": {
      "emit": "ablation",
      "input": "aco_settings_ablation.json"
    },
    "EPOCH_TABLE": {
      "emit": "epoch-table",
      "input": "budget_k2t5i_PN",
      "ants": 100,
      "file": "epoch-table.tex"
    },
    "REDUCE": {
      "emit": "reduce",
      "input": "super_reduce_phases.json",
      "sweep": "reduce_sweep",
      "file": "reduce.tex"
    },
    "HEURISTICS": {
      "emit": "heuristics",
      "input": "three_heuristics.json",
      "file": "heuristics.tex"
    }
  }
}
