{
  "source": "main.tex",
  "output": "build.tex",
  "generated_dir": "generated",
  "pdf": "build.pdf",
  "results_dir": "../results",
  "vary_base": "vary_",
  "max_replicates": 1,
  "fragments": {
    "QUALITY": {
      "emit": "quality",
      "input": "vary_k2t5i_2_200_PN",
      "file": "quality.tex"
    },
    "SEED_COMPARE": {
      "emit": "seed-compare",
      "input": "compare_k2t5i",
      "vary_dir": "vary_k2t5i_PN",
      "file": "seed-compare.tex"
    },
    "TABLE": {
      "emit": "table",
      "ants": 100,
      "file": "table.tex"
    },
    "COMPARE": {
      "emit": "compare",
      "input": "vary_k2t5i_PN",
      "ants": 100,
      "flag_dirs": {
        "ACO": "vary_k2t5i_100_",
        "$F_P$": "vary_k2t5i_P",
        "$F_N$": "vary_k2t5i_100_N",
        "$F_{PN}$": "vary_k2t5i_PN"
      },
      "param_dirs": {
        "k1t5": "vary_k1t5i_PN",
        "k2t5": "vary_k2t5i_PN",
        "k3t5": "vary_k3t5i_PN",
        "k4t5": "vary_k4t5i_PN",
        "k3t6": "vary_k3t6i_PN",
        "k3t7": "vary_k3t7i_PN"
      }
    },
    "STATISTICS": {
      "emit": "statistics",
      "input": "vary_k2t5i_PN",
      "ants": 100,
      "missing_at_base": "vary_k2t5i_100_",
      "compare_dir": "compare_k2t5i"
    }
  }
}
